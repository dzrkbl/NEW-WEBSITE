---
import { Image } from 'astro:assets';
import photoNinjas from '../assets/photos/ninjas-coach.jpg';
import photoKarate from '../assets/photos/karate-kumite.jpg';
import photoJudo from '../assets/photos/judo-enfants.jpg';
import photoKick from '../assets/photos/salle-entrainement.jpg';
import photoAgilite from '../assets/photos/ninjas-agilite.jpg';

const programmes = [
  {
    nom: 'Ninjas U8',
    jp: '忍者',
    ages: '4 à 8 ans',
    photo: photoNinjas,
    alt: 'Coach du CSHP guidant un jeune enfant portant des gants d’entraînement',
    texte: 'Initiation ludique et structurée aux arts martiaux : motricité, souplesse, discipline et beaucoup de plaisir.',
  },
  {
    nom: 'Karaté',
    jp: '空手',
    ages: '6 ans et +',
    photo: photoKarate,
    alt: 'Deux jeunes karatékas en kumité sur les tatamis du CSHP',
    texte: 'Technique, respect et dépassement de soi, de la ceinture blanche jusqu’à la compétition provinciale.',
  },
  {
    nom: 'Judo',
    jp: '柔道',
    ages: '6 ans et +',
    photo: photoJudo,
    alt: 'Deux enfants en kimonos blanc et bleu pendant un exercice de judo',
    texte: 'Chutes, projections et contrôle : la voie de la souplesse, encadrée par des compétiteurs d’expérience.',
  },
  {
    nom: 'Cardio-kickboxing femmes',
    jp: null,
    ages: 'Adultes',
    photo: photoKick,
    alt: 'Zone d’entraînement du CSHP avec sacs de frappe',
    texte: 'Cardio, confiance et défoulement entre femmes, le jeudi soir et le dimanche matin.',
  },
];
---

<section id="programmes" aria-labelledby="programmes-titre">
  <div class="colonne">
    <div class="entete-section revele">
      <p class="kicker">Nos programmes</p>
      <h2 id="programmes-titre" class="display">Un tatami pour<br />chaque ambition</h2>
      <p class="intro">
        Loisir ou compétition, premier cours ou ceinture noire : chaque groupe est bâti
        autour de l'âge et du niveau de votre enfant.
      </p>
    </div>

    <div class="grille cascade">
      {programmes.map((p) => (
        <article class="carte revele">
          <figure class="carte-photo cadre">
            <Image src={p.photo} alt={p.alt} widths={[420, 760]} sizes="(max-width: 520px) 92vw, (max-width: 1000px) 46vw, 24vw" />
            {p.jp && <span class="jp carte-jp" aria-hidden="true">{p.jp}</span>}
            <figcaption>
              <span class="carte-ages">{p.ages}</span>
              <h3 class="display carte-nom">{p.nom}</h3>
            </figcaption>
          </figure>
          <p class="carte-texte">{p.texte}</p>
        </article>
      ))}
    </div>

    <div class="bandeau revele" id="parascolaire">
      <div class="bandeau-photo cadre">
        <Image
          src={photoAgilite}
          alt="Enfants du programme parascolaire franchissant une échelle d'agilité au dojo"
          widths={[640, 1100]}
          sizes="(max-width: 900px) 92vw, 46vw"
        />
      </div>
      <div class="bandeau-corps">
        <p class="kicker">Après l'école &amp; l'été</p>
        <h3 class="display bandeau-titre">Parascolaire<br />et camp de jour</h3>
        <p>
          Un service de garde actif, encadré par nos coachs : les jeunes bougent, apprennent
          les arts martiaux et développent leur discipline pendant que vous terminez votre journée.
          L'été, le camp de jour prend le relais.
        </p>
        <a href="#essai" class="btn btn-contour">Demander les détails</a>
      </div>
    </div>
  </div>
</section>

<style>
  .grille { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .carte-photo { margin: 0; aspect-ratio: 3 / 4.4; }
  .carte-photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1400ms var(--sortie); }
  /* Le bas de la photo se fond au noir pour porter le nom du programme. */
  .carte-photo::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(0deg, rgb(var(--noir-rgb) / 0.94) 0%, rgb(var(--noir-rgb) / 0.2) 50%, rgb(var(--noir-rgb) / 0.3) 100%);
  }
  figcaption { position: absolute; z-index: 1; left: 22px; right: 22px; bottom: 20px; display: flex; flex-direction: column; gap: 6px; }
  .carte-ages { font-size: 14.5px; color: var(--ivoire-2); }
  .carte-nom { font-size: clamp(36px, 3.5vw, 48px); }
  .carte-jp { position: absolute; z-index: 1; top: 18px; right: 16px; writing-mode: vertical-rl; color: var(--ivoire-2); }
  .carte-texte { font-size: 15.5px; color: var(--sourdine); margin: 18px 0 0; line-height: 1.55; padding-right: 8px; }
  @media (hover: hover) { .carte:hover .carte-photo :global(img) { transform: scale(1.045); } }

  .bandeau {
    margin-top: clamp(64px, 8vw, 120px); padding-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--filet);
    display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .bandeau-photo :global(img) { aspect-ratio: 16 / 10; object-fit: cover; width: 100%; }
  .bandeau-titre { font-size: clamp(42px, 4.6vw, 68px); margin: 18px 0 20px; }
  .bandeau-corps p { color: var(--ivoire-2); }
  .bandeau-corps .btn { margin-top: 10px; }

  @media (max-width: 1000px) { .grille { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) { .bandeau { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .grille { grid-template-columns: 1fr; gap: 34px; } .carte-photo { aspect-ratio: 4 / 4.2; } }
</style>
