---
import club from '../data/club.json';
import FormulaireEssai from './FormulaireEssai.astro';
const adresseMaps = encodeURIComponent(`${club.nom}, ${club.adresse.rue}, ${club.adresse.ville}, ${club.adresse.province}`);
---

<section id="essai" class="bande-sombre" aria-labelledby="essai-titre">
  <div class="colonne essai-grille">
    <div class="essai-texte revele">
      <p class="kicker">Essai gratuit</p>
      <h2 id="essai-titre" class="display essai-titre">Le premier cours,<br />c'est <em>nous</em> qui l'offrons</h2>
      <p>
        Venez voir le dojo, rencontrer les coachs et laisser votre enfant essayer un vrai
        cours, sans frais et sans engagement. Remplissez le formulaire et un membre de
        l'équipe vous rappelle pour planifier la visite.
      </p>
      <div class="coordonnees" id="contact">
        <p>
          <span class="etiquette">Téléphone</span>
          <a href={`tel:${club.telephoneHref}`} class="tabulaire valeur">{club.telephone}</a>
        </p>
        <p>
          <span class="etiquette">Courriel</span>
          <a href={`mailto:${club.courriel}`} class="valeur">{club.courriel}</a>
        </p>
        <p>
          <span class="etiquette">Adresse</span>
          <a href={`https://www.google.com/maps/search/?api=1&query=${adresseMaps}`} target="_blank" rel="noopener" class="valeur">
            {club.adresse.rue}, {club.adresse.quartier}, {club.adresse.ville}
          </a>
        </p>
      </div>
    </div>

    <div class="essai-form revele">
      <FormulaireEssai provenance="WEB" tag="accueil" />
    </div>
  </div>

  <style>
    .essai-grille { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(32px, 5vw, 80px); align-items: start; }
    .essai-titre { font-size: clamp(34px, 5vw, 58px); margin: 14px 0 18px; }
    .essai-titre em { font-style: normal; color: var(--rouge-vif); }
    .essai-texte > p { color: var(--sur-sombre-sourdine); }

    .coordonnees { margin-top: 30px; display: flex; flex-direction: column; gap: 16px; }
    .coordonnees p { margin: 0; display: flex; flex-direction: column; gap: 2px; }
    .etiquette { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sur-sombre-sourdine); font-weight: 700; }
    .valeur { color: var(--sur-sombre); font-size: 17px; font-weight: 600; text-decoration-color: rgba(245,242,236,0.3); }
    .valeur:hover { color: #fff; }

    @media (max-width: 900px) { .essai-grille { grid-template-columns: 1fr; } }
  </style>
</section>
