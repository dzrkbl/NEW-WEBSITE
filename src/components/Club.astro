---
import { Image } from 'astro:assets';
import club from '../data/club.json';
import photoSeiza from '../assets/photos/seiza-discipline.jpg';
import photoMur from '../assets/photos/mur-logo.jpg';

const chiffres = [
  { valeur: String(club.fondation), legende: 'Année de fondation' },
  { valeur: '4-18', legende: 'Âges des athlètes' },
  { valeur: club.surface, legende: 'De tatamis et de gym' },
  { valeur: String(club.federations.length), legende: 'Fédérations partenaires' },
];
---

<section id="club" aria-labelledby="club-titre">
  <div class="colonne club-grille">
    <div class="club-texte revele">
      <p class="kicker">Le club</p>
      <h2 id="club-titre" class="display entete-club">Une entreprise familiale,<br />des standards de compétition</h2>
      <p>
        Fondé en {club.fondation} à {club.adresse.quartier}, le CSHP est né d'une conviction :
        les arts martiaux forment autant le caractère que le corps. Nos fondateurs et
        entraîneurs ont performé au plus haut niveau de leurs disciplines. Ils transmettent
        aujourd'hui la même exigence, dans un esprit d'entraide et de famille.
      </p>
      <p>
        Discipline, respect, persévérance : chaque cours est pensé pour faire progresser
        l'athlète <em>et</em> le citoyen. Du premier salut aux championnats de
        Karaté Québec et Judo Québec, chaque jeune avance à son rythme et trouve sa place.
      </p>
      <dl class="chiffres tabulaire">
        {chiffres.map((c) => (
          <div class="chiffre">
            <dt>{c.legende}</dt>
            <dd class="display">{c.valeur}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="club-photos revele">
      <div class="cadre photo-a">
        <Image src={photoSeiza} alt="Jeunes karatékas agenouillés en seiza, alignés sur le tatami" widths={[520, 900]} sizes="(max-width: 900px) 92vw, 34vw" />
      </div>
      <div class="cadre photo-b">
        <Image src={photoMur} alt="Le mur du dojo avec le logo du Centre Sportif de Haute-Performance" widths={[520, 900]} sizes="(max-width: 900px) 92vw, 30vw" />
      </div>
    </div>
  </div>
</section>

<style>
  section { background: var(--papier-2); }
  .club-grille { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .entete-club { font-size: clamp(32px, 4.6vw, 52px); margin: 14px 0 18px; }
  .club-texte p { color: var(--encre-2); }
  .club-texte em { font-style: italic; }

  .chiffres {
    display: grid; grid-template-columns: repeat(4, auto);
    gap: clamp(18px, 3vw, 40px);
    margin: 30px 0 0; padding: 22px 0 0;
    border-top: 1px solid var(--ligne);
  }
  .chiffre dt { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sourdine); font-weight: 600; }
  .chiffre dd { margin: 2px 0 0; font-size: clamp(30px, 3.4vw, 44px); color: var(--rouge); }

  .club-photos { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
  .photo-a img { aspect-ratio: 3 / 4; object-fit: cover; }
  .photo-b { margin-top: 46px; }
  .photo-b img { aspect-ratio: 4 / 5; object-fit: cover; }

  @media (max-width: 900px) {
    .club-grille { grid-template-columns: 1fr; }
    .chiffres { grid-template-columns: repeat(2, 1fr); }
  }
</style>
