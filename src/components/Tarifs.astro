---
import tarifs from '../data/tarifs.json';
---

<section id="tarifs" class="filet-haut" aria-labelledby="tarifs-titre">
  <div class="colonne">
    <div class="entete-section revele">
      <p class="kicker">Tarifs</p>
      <h2 id="tarifs-titre" class="display">Simples et sans surprise</h2>
      <p class="intro">
        Deux formules, taxes incluses. Et avant de choisir&nbsp;: un cours d'essai gratuit,
        sans engagement. C'est toujours par là qu'on commence.
      </p>
    </div>

    <div class="cartes revele">
      {tarifs.plans.map((p) => (
        <article class={`carte ${p.populaire ? 'populaire' : ''}`}>
          {p.populaire && <p class="badge">Le choix des familles</p>}
          <h3 class="display nom">{p.nom}</h3>
          <p class="prix tabulaire">
            <span class="montant">{p.prix}&nbsp;$</span>
            <span class="periode">pour {p.periode}, taxes incluses</span>
          </p>
          <p class="desc">{p.description}</p>
          <ul role="list">
            {p.details.map((d) => <li>{d}</li>)}
          </ul>
          <a href="#essai" class={`btn ${p.populaire ? 'btn-rouge' : 'btn-contour'}`}>Commencer par un essai</a>
        </article>
      ))}
      <aside class="famille revele">
        <p class="display famille-pct">-{tarifs.rabaisFamille.pct}&nbsp;%</p>
        <p class="famille-texte">{tarifs.rabaisFamille.texte}</p>
        <ul role="list">
          {tarifs.notes.map((n) => <li>{n}</li>)}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .cartes { display: grid; grid-template-columns: 1fr 1fr 0.9fr; gap: 18px; align-items: stretch; }
  .carte {
    background: var(--noir-2); border: 1px solid var(--filet); border-radius: var(--rayon);
    padding: 62px 30px 30px; display: flex; flex-direction: column; position: relative;
  }
  /* La formule recommandée : un filet rouge en tête, rien de plus. */
  .carte.populaire { border-top: 2px solid var(--rouge); }
  .badge { position: absolute; top: 24px; left: 30px; display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--ivoire); margin: 0; }
  .badge::before { content: ""; width: 20px; height: 1px; background: var(--rouge); }
  .nom { font-size: 30px; letter-spacing: 0.03em; color: var(--sourdine); margin-bottom: 4px; }
  .prix { display: flex; flex-direction: column; gap: 4px; margin: 0 0 16px; }
  .montant { font-family: var(--display); font-weight: 400; font-size: clamp(70px, 6.4vw, 92px); line-height: 0.9; color: var(--ivoire); }
  .periode { font-size: 14.5px; color: var(--sourdine); }
  .desc { color: var(--ivoire-2); font-size: 16px; }
  .carte ul { list-style: none; margin: 4px 0 26px; padding: 0; display: flex; flex-direction: column; flex: 1; border-top: 1px solid var(--filet); }
  .carte li { display: flex; align-items: center; gap: 12px; font-size: 15.5px; color: var(--ivoire-2); padding: 11px 0; border-bottom: 1px solid var(--filet); }
  .carte li::before { content: ""; width: 12px; height: 1px; background: var(--rouge); flex: 0 0 auto; }
  .famille {
    border: 1px solid var(--filet); border-radius: var(--rayon); padding: 62px 30px 30px;
    display: flex; flex-direction: column;
  }
  .famille-pct { font-size: clamp(70px, 6.4vw, 92px); line-height: 0.9; }
  .famille-texte { font-weight: 500; font-size: 17px; color: var(--ivoire); margin: 14px 0 18px; }
  .famille ul { list-style: none; margin: auto 0 0; padding: 18px 0 0; border-top: 1px solid var(--filet); display: flex; flex-direction: column; gap: 10px; }
  .famille li { font-size: 14.5px; color: var(--sourdine); }
  @media (max-width: 960px) { .cartes { grid-template-columns: 1fr 1fr; } .famille { grid-column: 1 / -1; } }
  @media (max-width: 620px) { .cartes { grid-template-columns: 1fr; } .famille { grid-column: auto; } }
</style>
