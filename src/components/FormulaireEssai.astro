---
// Formulaire d'essai gratuit, réutilisé par l'accueil et les landing pages.
//
// Contrat API (vérifié contre src/routes/leads.ts de l'app de gestion) :
//   POST {club.apiLeads} accepte firstName* lastName* gender phone email sport
//   requestType (ESSAI|RAPPEL|TARIFS|AUTRE) et le honeypot `website` (présent et vide).
//   Tout champ inconnu est silencieusement supprimé par zod.
// Contrat cible (chantier côté app) envoyé EN PLUS dès maintenant : source,
//   utmSource, utmCampaign, utmContent, note. Ignorés aujourd'hui, captés dès
//   que l'app les ajoute. Aucun changement du site à prévoir à ce moment-là.
// Pixel : événement « Lead » (avec eventID unique pour la déduplication CAPI)
//   uniquement après une réponse 200 de l'API.
import club from '../data/club.json';

interface Props {
  tag?: string;             // identifiant d'angle : accueil, karate-enfant, ninjas-4-8…
  sportInitial?: string;
  sportVerrouille?: boolean;
  avecAge?: boolean;
  cta?: string;
}
const {
  tag = 'accueil',
  sportInitial = 'KARATE',
  sportVerrouille = false,
  avecAge = true,
  cta = 'Réserver mon essai gratuit',
} = Astro.props;

const source = tag === 'accueil' ? 'site-accueil' : `landing-${tag}`;
const sports = [
  ['KARATE', 'Karaté'],
  ['JUDO', 'Judo'],
  ['NINJAS', 'Ninjas U8 (4-8 ans)'],
  ['KICKBOXING', 'Cardio-kickboxing femmes'],
  ['AUTRE', 'Autre / je ne sais pas encore'],
];
const idBase = `essai-${tag}`;
---

<form class="formulaire" method="post" novalidate data-tag={tag} data-source={source}>
  <div class="champ-rangee">
    <div class="champ">
      <label for={`${idBase}-prenom`}>Votre prénom</label>
      <input id={`${idBase}-prenom`} name="firstName" type="text" autocomplete="given-name" required />
    </div>
    <div class="champ">
      <label for={`${idBase}-nom`}>Votre nom</label>
      <input id={`${idBase}-nom`} name="lastName" type="text" autocomplete="family-name" required />
    </div>
  </div>
  <div class="champ-rangee">
    <div class="champ">
      <label for={`${idBase}-tel`}>Téléphone</label>
      <input id={`${idBase}-tel`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
    </div>
    <div class="champ">
      <label for={`${idBase}-courriel`}>Courriel</label>
      <input id={`${idBase}-courriel`} name="email" type="email" autocomplete="email" required />
    </div>
  </div>
  {sportVerrouille ? (
    <input type="hidden" name="sport" value={sportInitial} />
  ) : (
    <div class="champ-rangee">
      <div class="champ">
        <label for={`${idBase}-sport`}>Activité</label>
        <select id={`${idBase}-sport`} name="sport">
          {sports.map(([valeur, etiquette]) => (
            <option value={valeur} selected={valeur === sportInitial}>{etiquette}</option>
          ))}
        </select>
      </div>
      {avecAge && (
        <div class="champ">
          <label for={`${idBase}-age`}>Âge de l'enfant <span class="optionnel">(optionnel)</span></label>
          <input id={`${idBase}-age`} name="age" type="text" inputmode="numeric" />
        </div>
      )}
    </div>
  )}
  <div class="champ">
    <label for={`${idBase}-message`}>Un mot sur vos objectifs <span class="optionnel">(optionnel)</span></label>
    <textarea id={`${idBase}-message`} name="message" rows="3"></textarea>
  </div>
  <p class="hp" aria-hidden="true">
    <label>Ne pas remplir ce champ
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </p>
  <button type="submit" class="btn btn-rouge">{cta}</button>
  <p class="statut" role="status" aria-live="polite"></p>
  <p class="repli">
    Un pépin avec le formulaire ? Appelez-nous au
    <a href={`tel:${club.telephoneHref}`} class="tabulaire">{club.telephone}</a>, ça nous fera plaisir.
  </p>
</form>

<script>
  import club from '../data/club.json';

  const utm = new URLSearchParams(window.location.search);

  document.querySelectorAll<HTMLFormElement>('form.formulaire').forEach((form) => {
    const statut = form.querySelector<HTMLParagraphElement>('.statut');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity() || !statut) return;
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      const tag = form.dataset.tag || 'accueil';
      const note = [data.message, data.age ? `Âge de l'enfant : ${data.age}` : '']
        .filter(Boolean)
        .join(' | ');
      const corps: Record<string, string> = {
        // Contrat actuel de l'app
        firstName: data.firstName,
        lastName: data.lastName,
        phone: data.phone,
        email: data.email,
        sport: data.sport,
        requestType: 'ESSAI',
        website: data.website || '',
        // Contrat cible (ignoré par zod tant que l'app ne l'a pas déployé)
        source: form.dataset.source || 'site',
      };
      for (const cle of ['utm_source', 'utm_campaign', 'utm_content'] as const) {
        const v = utm.get(cle);
        if (v) corps[cle.replace(/_(\w)/, (_, c) => c.toUpperCase())] = v; // utmSource, utmCampaign, utmContent
      }
      if (note) corps.note = note;

      statut.textContent = 'Envoi en cours…';
      try {
        const r = await fetch(club.apiLeads, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(corps),
        });
        if (!r.ok) throw new Error(String(r.status));
        statut.textContent = 'Merci ! Votre demande est bien reçue. On vous rappelle rapidement.';
        form.reset();
        const eventID = (crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random()}`);
        (window as any).fbq?.('track', 'Lead', { content_name: tag }, { eventID });
      } catch {
        statut.textContent =
          'Le formulaire ne répond pas pour le moment. Appelez-nous ou écrivez-nous, les coordonnées sont juste à côté.';
        (window as any).fbq?.('trackCustom', 'LeadFormEchec', { content_name: tag });
      }
    });
  });
</script>

<style>
  .formulaire { background: var(--papier); color: var(--encre); border-radius: var(--rayon); padding: clamp(22px, 3vw, 34px); }
  .champ { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
  .champ-rangee { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  label { font-size: 13.5px; font-weight: 700; }
  .optionnel { color: var(--sourdine); font-weight: 500; }
  input, select, textarea {
    font: inherit; color: var(--encre);
    background: #fff; border: 1px solid var(--ligne); border-radius: var(--rayon);
    padding: 11px 12px;
  }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--rouge); outline-offset: 1px; border-color: var(--rouge); }
  .hp { position: absolute; left: -9999px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  button.btn { width: 100%; margin-top: 4px; }
  .statut { min-height: 1.4em; font-weight: 600; font-size: 14.5px; margin: 12px 0 0; color: var(--encre-2); }
  .repli { font-size: 13.5px; color: var(--sourdine); margin: 10px 0 0; }
  .repli a { color: var(--encre); }
  @media (max-width: 560px) { .champ-rangee { grid-template-columns: 1fr; } }
</style>
