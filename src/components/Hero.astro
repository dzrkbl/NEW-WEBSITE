---
import { Image } from 'astro:assets';
import club from '../data/club.json';
import photoHero from '../assets/photos/hero-judo-enfants.jpg';
---

<section class="hero" aria-labelledby="hero-titre">
  <div class="hero-texte">
    <div class="hero-bloc">
      <h1 id="hero-titre">
        <span class="kicker hero-kicker">École de karaté, judo &amp; ninjas — {club.adresse.quartier}, {club.adresse.ville}</span>
        <span class="display hero-display">
          La confiance<br />s'apprend <em>ici.</em>
        </span>
      </h1>
      <p class="hero-sous">
        Arts martiaux pour les 4 à 18 ans — du premier salut jusqu'au podium.
        Encadrement de calibre compétitif, esprit de famille, à deux pas de chez vous.
      </p>
      <div class="hero-actions">
        <a href="#essai" class="btn btn-rouge">Réserver un essai gratuit</a>
        <a href="#horaire" class="btn btn-contour-clair">Voir l'horaire</a>
      </div>
      <ul class="hero-preuves" role="list">
        <li>Fondé en {club.fondation}</li>
        <li>Affilié Karaté&nbsp;Québec &amp; Judo&nbsp;Québec</li>
        <li>Dojo de {club.surface}</li>
      </ul>
    </div>
  </div>
  <div class="hero-photo-cadre">
    <Image
      src={photoHero}
      alt="Deux enfants du CSHP en plein combat de judo, kimonos blanc et bleu, sous le regard de leurs coachs"
      widths={[640, 1060]}
      sizes="(max-width: 900px) 100vw, 55vw"
      class="hero-photo"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(460px, 45%) 1fr;
    min-height: clamp(560px, 86vh, 820px);
    padding: 0; /* annule le padding global des sections : la photo touche les bords */
    background: var(--sombre);
    color: var(--sur-sombre);
  }
  .hero-texte { display: flex; align-items: center; }
  .hero-bloc {
    padding: clamp(40px, 6vw, 80px) clamp(22px, 4vw, 56px) clamp(40px, 6vw, 80px) clamp(18px, 4vw, 40px);
    margin-left: max(0px, calc((100vw - var(--colonne)) / 2));
    max-width: 600px;
  }
  h1 { display: flex; flex-direction: column; gap: 18px; }
  .hero-kicker { color: #fff; }
  .hero-kicker::before { background: var(--rouge-vif); }
  .hero-display { font-size: clamp(48px, 6vw, 86px); color: #fff; }
  .hero-display em { font-style: normal; color: var(--rouge-vif); }
  .hero-sous { margin-top: 20px; font-size: clamp(16.5px, 1.8vw, 18.5px); max-width: 46ch; color: rgba(245, 242, 236, 0.9); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; }
  .hero-preuves {
    list-style: none; display: flex; flex-wrap: wrap; gap: 10px 26px;
    margin: 34px 0 0; padding: 16px 0 0; border-top: 1px solid rgba(245, 242, 236, 0.22);
    font-size: 14px; font-weight: 500; color: rgba(245, 242, 236, 0.85);
  }
  .hero-preuves li { display: flex; align-items: center; gap: 8px; }
  .hero-preuves li::before { content: ""; width: 6px; height: 6px; background: var(--rouge-vif); border-radius: 50%; }

  .hero-photo-cadre { position: relative; overflow: hidden; }
  .hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 42%; }
  /* liseré discret entre panneau et photo */
  .hero-photo-cadre::before {
    content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px;
    background: var(--rouge); z-index: 1;
  }

  @media (max-width: 900px) {
    .hero { display: flex; flex-direction: column-reverse; min-height: 0; }
    .hero-photo-cadre { aspect-ratio: 5 / 4; }
    .hero-photo { position: absolute; }
    .hero-photo-cadre::before { left: 0; right: 0; top: auto; bottom: 0; width: auto; height: 4px; }
    .hero-bloc { margin-left: 0; max-width: none; padding: 30px clamp(18px, 4vw, 40px) 44px; }
    .hero-display { font-size: clamp(46px, 11vw, 64px); }
  }
</style>
