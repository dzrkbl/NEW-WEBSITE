---
import { getImage } from 'astro:assets';
import club from '../data/club.json';
import photoHero from '../assets/photos/hero-judo-enfants.jpg';
import photoHeroMobile from '../assets/photos/hero-judo-enfants-mobile.jpg';

const heroDesktop = await getImage({ src: photoHero, width: 1170, format: 'webp' });
const heroMobile = await getImage({ src: photoHeroMobile, width: 820, format: 'webp' });
---

<section class="hero" aria-labelledby="hero-titre">
  <picture class="hero-photo-cadre">
    <source media="(max-width: 700px)" srcset={heroMobile.src} />
    <img
      src={heroDesktop.src}
      alt="Deux enfants du CSHP en plein combat de judo, kimonos blanc et bleu, sur les tatamis du dojo"
      class="hero-photo"
      loading="eager"
      fetchpriority="high"
      width={heroDesktop.attributes.width}
      height={heroDesktop.attributes.height}
    />
  </picture>
  <div class="hero-voile" aria-hidden="true"></div>
  <div class="colonne hero-contenu">
    <h1 id="hero-titre">
      <span class="kicker hero-kicker">École de karaté, judo et ninjas à {club.adresse.quartier}, {club.adresse.ville}</span>
      <span class="display hero-display">
        La confiance<br />s'apprend <em>ici.</em>
      </span>
    </h1>
    <p class="hero-sous">
      Arts martiaux pour les 4 à 18 ans, du premier salut jusqu'au podium.
      Encadrement de calibre compétitif, esprit de famille, à deux pas de chez vous.
    </p>
    <div class="hero-actions">
      <a href="#essai" class="btn btn-rouge">Réserver un essai gratuit</a>
      <a href="#horaire" class="btn btn-contour-clair">Voir l'horaire</a>
    </div>
    <ul class="hero-preuves" role="list">
      <li>Fondé en {club.fondation}</li>
      <li>Affilié Karaté&nbsp;Québec et Judo&nbsp;Québec</li>
      <li>Dojo de {club.surface}</li>
    </ul>
  </div>
</section>

<style>
  .hero { position: relative; min-height: clamp(540px, 84vh, 800px); display: flex; align-items: flex-end; overflow: hidden; background: var(--sombre); }
  .hero-photo-cadre { position: absolute; inset: 0; display: block; }
  .hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  .hero-voile {
    position: absolute; inset: 0;
    background:
      linear-gradient(to right, rgba(15, 16, 20, 0.5) 0%, rgba(15, 16, 20, 0.18) 34%, rgba(15, 16, 20, 0) 55%),
      linear-gradient(to top, rgba(15, 16, 20, 0.92) 0%, rgba(15, 16, 20, 0.42) 44%, rgba(15, 16, 20, 0.1) 72%, rgba(15, 16, 20, 0.22) 100%);
  }
  .hero-contenu { position: relative; width: 100%; color: var(--sur-sombre); padding-block: clamp(38px, 5.5vw, 64px); }
  h1 { display: flex; flex-direction: column; gap: 18px; }
  .hero-kicker { color: #fff; text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4); }
  .hero-kicker::before { background: var(--rouge-vif); }
  .hero-display { font-size: clamp(50px, 8.4vw, 104px); color: #fff; }
  .hero-display em { font-style: normal; color: var(--rouge-vif); }
  .hero-sous { margin-top: 18px; font-size: clamp(16.5px, 2vw, 19px); max-width: 44ch; color: rgba(245, 242, 236, 0.92); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 24px; }
  .hero-preuves {
    list-style: none; display: flex; flex-wrap: wrap; gap: 10px 26px;
    margin: 30px 0 0; padding: 16px 0 0; border-top: 1px solid rgba(245, 242, 236, 0.22);
    font-size: 14px; font-weight: 500; color: rgba(245, 242, 236, 0.85);
  }
  .hero-preuves li { display: flex; align-items: center; gap: 8px; }
  .hero-preuves li::before { content: ""; width: 6px; height: 6px; background: var(--rouge-vif); border-radius: 50%; }
  @media (max-width: 700px) {
    .hero-photo { object-position: 42% 30%; }
  }
</style>
