---
import { Image } from 'astro:assets';
import club from '../data/club.json';
import photoHero from '../assets/photos/hero-judo-projection.jpg';
---

<section class="hero" aria-labelledby="hero-titre">
  <Image
    src={photoHero}
    alt="Projection de judo entre deux jeunes athlètes du CSHP, kimonos blanc et bleu, sur les tatamis du dojo"
    widths={[640, 1024, 1600]}
    sizes="100vw"
    class="hero-photo"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-voile" aria-hidden="true"></div>
  <div class="colonne hero-contenu">
    <h1 id="hero-titre">
      <span class="kicker hero-kicker">École de karaté, judo &amp; ninjas — {club.adresse.quartier}, {club.adresse.ville}</span>
      <span class="display hero-display">
        La confiance<br />s'apprend <em>ici.</em>
      </span>
    </h1>
    <p class="hero-sous">
      Arts martiaux pour les 4 à 18 ans — du premier salut jusqu'au podium.
      Encadrement de calibre compétitif, esprit de famille, à deux pas de chez vous.
    </p>
    <div class="hero-actions">
      <a href="#essai" class="btn btn-rouge">Réserver un essai gratuit</a>
      <a href="#horaire" class="btn btn-contour-clair">Voir l'horaire</a>
    </div>
    <ul class="hero-preuves" role="list">
      <li>Fondé en {club.fondation}</li>
      <li>Affilié Karaté&nbsp;Québec &amp; Judo&nbsp;Québec</li>
      <li>Dojo de {club.surface}</li>
    </ul>
  </div>
</section>

<style>
  .hero { position: relative; min-height: clamp(560px, 86vh, 820px); display: flex; align-items: flex-end; overflow: hidden; background: var(--sombre); }
  .hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 38%; }
  .hero-voile {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(15, 16, 20, 0.92) 0%, rgba(15, 16, 20, 0.45) 42%, rgba(15, 16, 20, 0.18) 70%, rgba(15, 16, 20, 0.35) 100%);
  }
  .hero-contenu { position: relative; width: 100%; color: var(--sur-sombre); padding-block: clamp(40px, 6vw, 72px); }
  h1 { display: flex; flex-direction: column; gap: 18px; }
  .hero-kicker { color: #fff; text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4); }
  .hero-kicker::before { background: var(--rouge-vif); }
  .hero-display { font-size: clamp(52px, 9.5vw, 118px); color: #fff; }
  .hero-display em { font-style: normal; color: var(--rouge-vif); }
  .hero-sous { margin-top: 20px; font-size: clamp(16.5px, 2vw, 19px); max-width: 46ch; color: rgba(245, 242, 236, 0.92); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; }
  .hero-preuves {
    list-style: none; display: flex; flex-wrap: wrap; gap: 10px 26px;
    margin: 34px 0 0; padding: 16px 0 0; border-top: 1px solid rgba(245, 242, 236, 0.22);
    font-size: 14px; font-weight: 500; color: rgba(245, 242, 236, 0.85);
  }
  .hero-preuves li { display: flex; align-items: center; gap: 8px; }
  .hero-preuves li::before { content: ""; width: 6px; height: 6px; background: var(--rouge-vif); border-radius: 50%; }
</style>
