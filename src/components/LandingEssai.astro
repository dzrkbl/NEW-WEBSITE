---
// Corps commun des landing pages : héro sombre avec formulaire, preuve visuelle,
// horaire filtré du programme, rappel des tarifs, dernier appel.
// Chaque page publicitaire fournit son angle via les props. Créer une nouvelle
// landing = créer une page qui remplit ces props, rien d'autre.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import club from '../data/club.json';
import tarifs from '../data/tarifs.json';
import horaires from '../data/horaires.json';
import FormulaireEssai from './FormulaireEssai.astro';

interface Props {
  kicker: string;
  titreHtml: string;           // contenu du H1 (peut contenir <em>)
  arguments_: string[];        // 3 arguments courts
  sport: string;               // valeur envoyée au CRM (KARATE, JUDO, NINJAS, KICKBOXING)
  tag: string;                 // identifiant d'angle joint au message ([tag])
  disciplinesHoraire: string[];// clés de horaires.json à afficher
  photo: ImageMetadata;
  photoAlt: string;
  sportVerrouille?: boolean;
  avecAge?: boolean;
}
const {
  kicker, titreHtml, arguments_, sport, tag, disciplinesHoraire,
  photo, photoAlt, sportVerrouille = false, avecAge = true,
} = Astro.props;

type Cle = keyof typeof horaires.disciplines;
const disciplines = horaires.disciplines as Record<Cle, { label: string; couleur: string }>;
const grille = horaires.jours
  .map((j) => ({
    jour: j.jour,
    cours: j.cours.filter((c) => disciplinesHoraire.includes(c.discipline)),
  }))
  .filter((j) => j.cours.length > 0);

const etapes = [
  { titre: 'Remplissez le formulaire', texte: 'Une minute, pas plus. Vos coordonnées restent au club.' },
  { titre: 'On vous rappelle', texte: "Un membre de l'équipe vous propose un créneau d'essai qui vous convient." },
  { titre: 'Venez essayer, gratuitement', texte: 'Un vrai cours, avec le groupe et les coachs. Vous décidez après.' },
];
const annuel = tarifs.plans.find((p) => p.id === 'ANNUEL');
const trimestriel = tarifs.plans.find((p) => p.id === 'TRIMESTRIEL');
---

<section class="lp-hero bande-sombre" aria-labelledby="lp-titre">
  <div class="colonne lp-hero-grille">
    <div class="lp-pitch">
      <p class="kicker">{kicker}</p>
      <h1 id="lp-titre" class="display lp-titre" set:html={titreHtml} />
      <ul class="lp-arguments" role="list">
        {arguments_.map((a) => <li>{a}</li>)}
      </ul>
      <ul class="lp-preuves" role="list">
        <li>Fondé en {club.fondation}</li>
        <li>Affilié aux fédérations provinciales et nationales</li>
        <li>{club.adresse.quartier}, {club.adresse.ville}</li>
      </ul>
    </div>
    <div class="lp-form" id="formulaire">
      <FormulaireEssai
        provenance="RESEAUX_SOCIAUX"
        tag={tag}
        sportInitial={sport}
        sportVerrouille={sportVerrouille}
        avecAge={avecAge}
      />
    </div>
  </div>
</section>

<section class="lp-etapes" aria-label="Comment ça marche">
  <div class="colonne">
    <ol class="etapes" role="list">
      {etapes.map((e, i) => (
        <li>
          <span class="etape-num display">{i + 1}</span>
          <span class="etape-corps">
            <strong>{e.titre}</strong>
            <span>{e.texte}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="lp-preuve" aria-label="Le dojo">
  <div class="colonne lp-preuve-grille">
    <div class="cadre">
      <Image src={photo} alt={photoAlt} widths={[640, 1100]} sizes="(max-width: 900px) 92vw, 52vw" />
    </div>
    <div class="lp-preuve-texte">
      <p class="kicker">Le dojo</p>
      <h2 class="display lp-h2">Un vrai centre d'entraînement, pas un sous-sol</h2>
      <ul role="list">
        <li>{club.surface} de tatamis et de gym</li>
        <li>Vestiaires, salles de bains, air renouvelé</li>
        <li>Coachs qui ont compété au plus haut niveau de leur discipline</li>
        <li>{club.adresse.rue}, {club.adresse.quartier}</li>
      </ul>
    </div>
  </div>
</section>

<section class="lp-horaire" aria-labelledby="lp-horaire-titre">
  <div class="colonne">
    <h2 id="lp-horaire-titre" class="display lp-h2">L'horaire du programme</h2>
    <ul class="lp-grille-horaire" role="list">
      {grille.map((j) => (
        <li>
          <span class="lp-jour">{j.jour}</span>
          <span class="lp-cours">
            {j.cours.map((c) => `${c.heure} ${disciplines[c.discipline as Cle].label} (${c.niveau})`).join(' · ')}
          </span>
        </li>
      ))}
    </ul>
    {trimestriel && annuel && (
      <p class="lp-tarif">
        Et après l'essai, si ça clique : {trimestriel.prix}&nbsp;$ par trimestre ou {annuel.prix}&nbsp;$ par année,
        taxes incluses. {tarifs.rabaisFamille.texte}
      </p>
    )}
  </div>
</section>

<section class="lp-final bande-sombre" aria-label="Réserver">
  <div class="colonne lp-final-int">
    <h2 class="display lp-h2">Le premier cours, c'est <em>nous</em> qui l'offrons</h2>
    <div class="lp-final-actions">
      <a href="#formulaire" class="btn btn-rouge">Réserver mon essai gratuit</a>
      <a href={`tel:${club.telephoneHref}`} class="btn btn-contour-clair tabulaire">{club.telephone}</a>
    </div>
  </div>
</section>

<style>
  .lp-hero { padding-block: clamp(36px, 5vw, 64px); }
  .lp-hero-grille { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 4vw, 64px); align-items: start; }
  .lp-titre { font-size: clamp(40px, 4.6vw, 62px); margin: 14px 0 20px; }
  .lp-titre :global(em) { font-style: normal; color: var(--rouge-vif); }
  .lp-arguments { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .lp-arguments li { display: flex; gap: 12px; font-size: 16.5px; align-items: baseline; }
  .lp-arguments li::before { content: ""; width: 14px; height: 3px; background: var(--rouge-vif); flex: 0 0 auto; transform: translateY(-4px); }
  .lp-preuves {
    list-style: none; display: flex; flex-wrap: wrap; gap: 8px 22px;
    margin: 26px 0 0; padding: 14px 0 0; border-top: 1px solid rgba(245, 242, 236, 0.2);
    font-size: 13.5px; color: var(--sur-sombre-sourdine);
  }
  .lp-preuves li { display: flex; align-items: center; gap: 8px; }
  .lp-preuves li::before { content: ""; width: 5px; height: 5px; background: var(--rouge-vif); border-radius: 50%; }

  .lp-etapes { padding-block: clamp(28px, 4vw, 48px); border-bottom: 1px solid var(--ligne); }
  .etapes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .etapes li { display: flex; gap: 14px; align-items: flex-start; }
  .etape-num { font-size: 40px; color: var(--rouge); line-height: 1; }
  .etape-corps { display: flex; flex-direction: column; gap: 3px; font-size: 14.5px; color: var(--encre-2); }
  .etape-corps strong { color: var(--encre); font-size: 15.5px; }

  .lp-preuve { padding-block: clamp(40px, 6vw, 72px); }
  .lp-preuve-grille { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(24px, 4vw, 56px); align-items: center; }
  .lp-preuve-grille img { aspect-ratio: 16 / 11; object-fit: cover; width: 100%; }
  .lp-h2 { font-size: clamp(28px, 3.6vw, 42px); margin: 12px 0 16px; }
  .lp-preuve-texte ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .lp-preuve-texte li { display: flex; gap: 12px; align-items: baseline; font-size: 15.5px; color: var(--encre-2); }
  .lp-preuve-texte li::before { content: ""; width: 7px; height: 7px; background: var(--rouge); border-radius: 1px; flex: 0 0 auto; }

  .lp-horaire { padding-block: clamp(36px, 5vw, 64px); background: var(--papier-2); }
  .lp-grille-horaire { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; max-width: 720px; }
  .lp-grille-horaire li {
    display: flex; gap: 18px; align-items: baseline;
    background: #fff; border: 1px solid var(--ligne); border-left: 4px solid var(--rouge);
    border-radius: var(--rayon); padding: 12px 16px;
  }
  .lp-jour { font-weight: 700; min-width: 92px; }
  .lp-cours { font-size: 14.5px; color: var(--encre-2); }
  .lp-tarif { margin: 22px 0 0; font-size: 15px; color: var(--encre-2); max-width: 66ch; }

  .lp-final { padding-block: clamp(36px, 5vw, 60px); }
  .lp-final-int { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .lp-final .lp-h2 { margin: 0; }
  .lp-final .lp-h2 :global(em), .lp-final em { font-style: normal; color: var(--rouge-vif); }
  .lp-final-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .lp-hero-grille, .lp-preuve-grille { grid-template-columns: 1fr; }
    .etapes { grid-template-columns: 1fr; gap: 16px; }
    .lp-grille-horaire li { flex-direction: column; gap: 2px; }
  }
</style>
