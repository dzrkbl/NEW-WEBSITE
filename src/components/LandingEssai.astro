---
// Corps commun des landing pages : héro sombre avec formulaire, preuve visuelle,
// horaire filtré du programme, rappel des tarifs, dernier appel.
// Chaque page publicitaire fournit son angle via les props. Créer une nouvelle
// landing = créer une page qui remplit ces props, rien d'autre.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import club from '../data/club.json';
import tarifs from '../data/tarifs.json';
import horaires from '../data/horaires.json';
import FormulaireEssai from './FormulaireEssai.astro';

interface Props {
  kicker: string;
  titreHtml: string;           // contenu du H1 (peut contenir <em>)
  arguments_: string[];        // 3 arguments courts
  sport: string;               // valeur envoyée au CRM (KARATE, JUDO, NINJAS, KICKBOXING)
  tag: string;                 // identifiant d'angle joint au message ([tag])
  disciplinesHoraire: string[];// clés de horaires.json à afficher
  photo: ImageMetadata;
  photoAlt: string;
  sportVerrouille?: boolean;
  avecAge?: boolean;
}
const {
  kicker, titreHtml, arguments_, sport, tag, disciplinesHoraire,
  photo, photoAlt, sportVerrouille = false, avecAge = true,
} = Astro.props;

type Cle = keyof typeof horaires.disciplines;
const disciplines = horaires.disciplines as Record<Cle, { label: string; couleur: string }>;
const grille = horaires.jours
  .map((j) => ({
    jour: j.jour,
    cours: j.cours.filter((c) => disciplinesHoraire.includes(c.discipline)),
  }))
  .filter((j) => j.cours.length > 0);

const etapes = [
  { titre: 'Remplissez le formulaire', texte: 'Une minute, pas plus. Vos coordonnées restent au club.' },
  { titre: 'On vous rappelle', texte: "Un membre de l'équipe vous propose un créneau d'essai qui vous convient." },
  { titre: 'Venez essayer, gratuitement', texte: 'Un vrai cours, avec le groupe et les coachs. Vous décidez après.' },
];
const annuel = tarifs.plans.find((p) => p.id === 'ANNUEL');
const trimestriel = tarifs.plans.find((p) => p.id === 'TRIMESTRIEL');
---

<section class="lp-hero" aria-labelledby="lp-titre">
  <div class="colonne lp-hero-grille">
    <div class="lp-pitch">
      <p class="kicker">{kicker}</p>
      <h1 id="lp-titre" class="display lp-titre" set:html={titreHtml} />
      <ul class="lp-arguments" role="list">
        {arguments_.map((a) => <li>{a}</li>)}
      </ul>
      <ul class="lp-preuves" role="list">
        <li>Fondé en {club.fondation}</li>
        <li>Affilié aux fédérations provinciales et nationales</li>
        <li>{club.adresse.quartier}, {club.adresse.ville}</li>
      </ul>
    </div>
    <div class="lp-form" id="formulaire">
      <FormulaireEssai
        tag={tag}
        sportInitial={sport}
        sportVerrouille={sportVerrouille}
        avecAge={avecAge}
      />
    </div>
  </div>
</section>

<section class="lp-etapes" aria-label="Comment ça marche">
  <div class="colonne">
    <ol class="etapes" role="list">
      {etapes.map((e, i) => (
        <li>
          <span class="etape-num display">{i + 1}</span>
          <span class="etape-corps">
            <strong>{e.titre}</strong>
            <span>{e.texte}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="lp-preuve" aria-label="Le dojo">
  <div class="colonne lp-preuve-grille">
    <div class="cadre">
      <Image src={photo} alt={photoAlt} widths={[640, 1100]} sizes="(max-width: 900px) 92vw, 52vw" />
    </div>
    <div class="lp-preuve-texte">
      <p class="kicker">Le dojo</p>
      <h2 class="display lp-h2">Un vrai centre d'entraînement, pas un sous-sol</h2>
      <ul role="list">
        <li>{club.surface} de tatamis et de gym</li>
        <li>Vestiaires, salles de bains, air renouvelé</li>
        <li>Coachs qui ont compété au plus haut niveau de leur discipline</li>
        <li>{club.adresse.rue}, {club.adresse.quartier}</li>
      </ul>
    </div>
  </div>
</section>

<section class="lp-horaire" aria-labelledby="lp-horaire-titre">
  <div class="colonne">
    <h2 id="lp-horaire-titre" class="display lp-h2">L'horaire du programme</h2>
    <ul class="lp-grille-horaire" role="list">
      {grille.map((j) => (
        <li>
          <span class="lp-jour">{j.jour}</span>
          <span class="lp-cours">
            {j.cours.map((c) => `${c.heure} ${disciplines[c.discipline as Cle].label} (${c.niveau})`).join(' · ')}
          </span>
        </li>
      ))}
    </ul>
    {trimestriel && annuel && (
      <p class="lp-tarif">
        Et après l'essai, si ça clique : {trimestriel.prix}&nbsp;$ par trimestre ou {annuel.prix}&nbsp;$ par année,
        taxes incluses. {tarifs.rabaisFamille.texte}
      </p>
    )}
  </div>
</section>

<section class="lp-final filet-haut" aria-label="Réserver">
  <div class="colonne lp-final-int">
    <h2 class="display lp-h2">Le premier cours, c'est <em>nous</em> qui l'offrons</h2>
    <div class="lp-final-actions">
      <a href="#formulaire" class="btn btn-rouge">Réserver mon essai gratuit</a>
      <a href={`tel:${club.telephoneHref}`} class="btn btn-contour-clair tabulaire">{club.telephone}</a>
    </div>
  </div>
</section>

<style>
  .lp-hero { padding-block: clamp(32px, 4vw, 56px) clamp(48px, 6vw, 80px); }
  .lp-hero-grille { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .lp-titre { font-size: clamp(56px, 6.4vw, 96px); margin: 20px 0 28px; }
  .lp-titre :global(em) { font-style: normal; }
  .lp-arguments { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; border-top: 1px solid var(--filet); }
  .lp-arguments li { display: flex; gap: 14px; font-size: 17px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--filet); color: var(--ivoire-2); }
  .lp-arguments li::before { content: ""; width: 14px; height: 1px; background: var(--rouge); flex: 0 0 auto; transform: translateY(-5px); }
  .lp-preuves {
    list-style: none; display: flex; flex-wrap: wrap; gap: 6px 26px;
    margin: 22px 0 0; padding: 0;
    font-size: 14.5px; color: var(--sourdine);
  }

  .lp-etapes { padding-block: clamp(36px, 5vw, 60px); border-top: 1px solid var(--filet); border-bottom: 1px solid var(--filet); }
  .etapes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .etapes li { display: flex; gap: 18px; align-items: flex-start; }
  .etape-num { font-size: 64px; color: var(--rouge); line-height: 0.85; }
  .etape-corps { display: flex; flex-direction: column; gap: 4px; font-size: 15.5px; color: var(--sourdine); }
  .etape-corps strong { color: var(--ivoire); font-size: 17px; font-weight: 500; }

  .lp-preuve { padding-block: clamp(56px, 7vw, 96px); }
  .lp-preuve-grille { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .lp-preuve-grille :global(img) { aspect-ratio: 16 / 11; object-fit: cover; width: 100%; }
  .lp-h2 { font-size: clamp(42px, 4.8vw, 70px); margin: 18px 0 22px; }
  .lp-preuve-texte ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; border-top: 1px solid var(--filet); }
  .lp-preuve-texte li { display: flex; gap: 14px; align-items: baseline; font-size: 16.5px; color: var(--ivoire-2); padding: 13px 0; border-bottom: 1px solid var(--filet); }
  .lp-preuve-texte li::before { content: ""; width: 14px; height: 1px; background: var(--rouge); flex: 0 0 auto; transform: translateY(-5px); }

  .lp-horaire { padding-block: clamp(48px, 6vw, 80px); border-top: 1px solid var(--filet); }
  .lp-horaire .lp-h2 { margin-top: 0; }
  .lp-grille-horaire { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; max-width: 760px; border-top: 1px solid var(--filet); }
  .lp-grille-horaire li { display: flex; gap: 22px; align-items: baseline; padding: 15px 0; border-bottom: 1px solid var(--filet); }
  .lp-jour { font-family: var(--display); font-size: 26px; letter-spacing: 0.03em; text-transform: uppercase; line-height: 1; color: var(--ivoire); min-width: 118px; }
  .lp-cours { font-size: 16px; color: var(--ivoire-2); }
  .lp-tarif { margin: 26px 0 0; font-size: 16px; color: var(--sourdine); max-width: 66ch; }

  .lp-final { padding-block: clamp(48px, 6vw, 80px); }
  .lp-final-int { display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; }
  .lp-final .lp-h2 { margin: 0; }
  .lp-final em { font-style: normal; }
  .lp-final-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .lp-hero-grille, .lp-preuve-grille { grid-template-columns: 1fr; }
    .etapes { grid-template-columns: 1fr; gap: 20px; }
    .lp-grille-horaire li { flex-direction: column; gap: 4px; }
  }
</style>
