---
import horaires from '../data/horaires.json';
import club from '../data/club.json';

type Cle = keyof typeof horaires.disciplines;
const disciplines = horaires.disciplines as Record<Cle, { label: string; couleur: string }>;
const legende = (['judo', 'karate', 'ninjas', 'kickboxing'] as Cle[]).map((k) => ({ cle: k, ...disciplines[k] }));

// Filtre par programme, 100 % CSS (boutons radio + :has), aucun JavaScript.
// Les règles sont générées à partir de la légende : ajouter une discipline à
// la légende suffit, rien à maintenir à la main. Écran large (semaine entière
// visible) : les autres cours s'estompent, la forme de la semaine reste lisible.
// Écran étroit (liste verticale) : ils disparaissent, la liste raccourcit.
const cssFiltre = legende
  .map((l) => {
    const actif = `#horaire:has(#filtre-${l.cle}:checked)`;
    const autresCours = `${actif} .cours:not([data-d="${l.cle}"])`;
    const joursVides = `${actif} .jour:not(:has([data-d="${l.cle}"]))`;
    return (
      `@media (min-width:1101px){${autresCours},${joursVides}{opacity:.2}}` +
      `@media (max-width:1100px){${autresCours},${joursVides}{display:none}}`
    );
  })
  .join('');
---

<section id="horaire" class="filet-haut" aria-labelledby="horaire-titre">
  <div class="colonne">
    <div class="entete-section revele">
      <p class="kicker">Horaire de la semaine</p>
      <h2 id="horaire-titre" class="display">Trouvez votre créneau</h2>
      <p class="intro">
        Soirs de semaine pour le karaté et le judo, samedi matin pour les Ninjas.
        Arrivez 10&nbsp;minutes d'avance : le tatami n'attend pas.
      </p>
    </div>

    <fieldset class="filtres revele">
      <legend class="visually-hidden">Filtrer l'horaire par programme</legend>
      <input type="radio" name="filtre-horaire" id="filtre-tous" class="visually-hidden" checked />
      <label for="filtre-tous">Tous les cours</label>
      {legende.map((l) => (
        <>
          <input type="radio" name="filtre-horaire" id={`filtre-${l.cle}`} class="visually-hidden" />
          <label for={`filtre-${l.cle}`}><span class={`pastille c-${l.couleur}`}></span>{l.label}</label>
        </>
      ))}
    </fieldset>
    <style is:inline set:html={cssFiltre}></style>

    <div class="grille-horaire revele">
      {horaires.jours.map((j) => (
        <div class="jour">
          <h3>{j.jour}</h3>
          {j.cours.length === 0 && <p class="repos">Fermé</p>}
          <ul role="list">
            {j.cours.map((c) => {
              const d = disciplines[c.discipline as Cle];
              return (
                <li class={`cours c-${d.couleur}`} data-d={c.discipline}>
                  <span class="heure tabulaire">{c.heure}</span>
                  <span class="quoi">
                    <span class="disc">{d.label}</span>
                    <span class="niveau">{c.niveau}</span>
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <p class="note revele">
      Heures d'ouverture : {club.heures.map((h, i) => `${h.jours.toLowerCase()} ${h.plage}`).join(' · ')}.
      L'horaire peut changer selon la session. <a href="#essai">Écrivez-nous</a> pour confirmer une place.
    </p>
  </div>
</section>

<style>
  /* Légende cliquable : chaque pastille filtre l'horaire. */
  .filtres {
    position: relative; border: 0; min-width: 0;
    display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 30px; padding: 0;
    font-size: 15px; color: var(--ivoire-2);
  }
  .filtres label {
    display: inline-flex; align-items: center; gap: 9px;
    min-height: 44px; padding: 0 18px;
    border: 1px solid var(--filet); border-radius: var(--rayon);
    cursor: pointer; user-select: none;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }
  .filtres label:hover { border-color: var(--filet-fort); }
  .filtres input:checked + label { background: var(--ivoire); border-color: var(--ivoire); color: var(--noir); font-weight: 500; }
  .filtres input:focus-visible + label { outline: 2px solid var(--ivoire); outline-offset: 3px; }
  /* Navigateur sans :has : le filtre ne peut pas agir, on retombe sur une simple légende. */
  @supports not selector(:has(*)) {
    .filtres { gap: 10px 24px; }
    .filtres input, .filtres label[for="filtre-tous"] { display: none; }
    .filtres label { min-height: 0; padding: 0; border: 0; cursor: default; }
  }
  .pastille { width: 9px; height: 9px; border-radius: 50%; display: inline-block; background: var(--c); }

  .grille-horaire { display: grid; grid-template-columns: repeat(7, 1fr); gap: 14px; }
  .jour { transition: opacity 260ms var(--sortie); }
  .jour h3 {
    font-family: var(--display); font-weight: 400; font-size: 27px; letter-spacing: 0.03em; line-height: 1;
    text-transform: uppercase;
    padding-bottom: 12px; border-bottom: 1px solid var(--filet-fort);
    margin-bottom: 12px;
  }
  .jour ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .cours {
    display: flex; flex-direction: column; gap: 3px;
    background: var(--noir-2); border: 1px solid var(--filet);
    border-left: 2px solid var(--c, var(--prog-neutre));
    border-radius: var(--rayon);
    padding: 12px 14px;
    transition: opacity 260ms var(--sortie);
  }
  .heure { font-size: 14px; color: var(--sourdine); }
  .quoi { display: flex; flex-direction: column; }
  .disc { font-weight: 500; font-size: 15.5px; line-height: 1.25; color: var(--ivoire); }
  .niveau { font-size: 14px; color: var(--sourdine); }
  .repos { color: var(--sourdine); font-size: 15px; }
  .note { margin-top: 30px; font-size: 15px; color: var(--sourdine); max-width: none; }
  .note a { color: var(--ivoire); text-decoration-color: var(--rouge); text-underline-offset: 4px; }

  @media (max-width: 1100px) { .grille-horaire { grid-template-columns: repeat(4, 1fr); gap: 22px 14px; } }
  @media (max-width: 760px) { .grille-horaire { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .grille-horaire { grid-template-columns: 1fr; } }
</style>
