---
import Landing from '../layouts/Landing.astro';
import LandingEssai from '../components/LandingEssai.astro';
import photo from '../assets/photos/salle-entrainement.jpg';
---

<Landing
  titre="Cardio-kickboxing femmes, essai gratuit à Montréal (Rosemont) | CSHP"
  description="Cours de cardio-kickboxing 100 % femmes au CSHP, Rosemont : cardio, confiance et défoulement, jeudi soir et dimanche matin. Premier cours gratuit."
>
  <LandingEssai
    kicker="100 % femmes · Premier cours gratuit"
    titreHtml="Frappez fort,<br />repartez <em>légère</em>"
    arguments_={[
      'Un groupe 100 % femmes, tous les niveaux, aucune expérience requise.',
      'Cardio, technique et défoulement, encadrés par un coach de kickboxing d’expérience.',
      'Jeudi 19 h 30 et dimanche 10 h : des créneaux pensés pour les horaires de famille.',
    ]}
    sport="KICKBOXING"
    tag="kickboxing-femmes"
    disciplinesHoraire={['kickboxing']}
    photo={photo}
    photoAlt="Zone d'entraînement du CSHP avec sacs de frappe et matériel de conditionnement"
    sportVerrouille={true}
    avecAge={false}
  />
</Landing>
